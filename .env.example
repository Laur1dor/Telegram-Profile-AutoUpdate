API_ID=
API_HASH=

# Прокси для всего трафика (MTProto + запросы курсов).
# Пусто = напрямую: так и оставьте, если Telegram в вашей сети не блокируется.
PROXY_URL=

# Если блокируется — поднимите один из профилей и укажите его адрес:
#   docker compose --profile warp up -d     PROXY_URL=socks5://warp:1080
#   docker compose --profile vless up -d    PROXY_URL=socks5://xray:2080
#COMPOSE_PROFILES=warp

# Для профиля vless:
#VLESS_SUBSCRIPTION=https://example.com/sub/xxxx
#VLESS_CONFIGS=vless://...,vless://...
#VLESS_CONFIGS_FILE=data/vless.txt
#VLESS_UPDATE_INTERVAL=21600
